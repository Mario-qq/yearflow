{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "node16",
    "moduleResolution": "node16",
    "types": ["node"],
    "outDir": "../dist-electron",
    "rootDir": ".",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "composite": true,
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.electron.tsbuildinfo"
  },
  "include": ["main.cts", "preload.cts"]
}
